rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() &&
        request.auth.uid in groupData(groupId).memberIds;
    }

    // Users Collection (Private profile read/write)
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // Usernames Collection (Public lookup for group adding; Immutable once created)
    match /usernames/{normalizedUsername} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Groups Collection
    match /groups/{groupId} {
      // Group creation
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;

      // Group read by members
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.memberIds;

      // Group update: timestamp updates by members without changing critical fields
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.memberIds == resource.data.memberIds;

      allow delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;

      // Members Subcollection
      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);
        // Members created at group setup or modified only by group creator
        allow create: if isAuthenticated() &&
          (request.auth.uid == groupData(groupId).createdBy || request.auth.uid == memberUid);
        allow update, delete: if isAuthenticated() &&
          request.auth.uid == groupData(groupId).createdBy;
      }

      // Expenses Subcollection (Immutable ledger entries)
      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.amountPaise is int &&
          request.resource.data.amountPaise > 0 &&
          request.resource.data.paidByUid in groupData(groupId).memberIds &&
          request.resource.data.participantIds is list &&
          request.resource.data.participantIds.hasOnly(groupData(groupId).memberIds) &&
          request.resource.data.splitType in ['equal', 'custom'];
        allow update, delete: if false;
      }

      // Settlements Subcollection (Immutable ledger entries)
      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.amountPaise is int &&
          request.resource.data.amountPaise > 0 &&
          request.resource.data.fromUid in groupData(groupId).memberIds &&
          request.resource.data.toUid in groupData(groupId).memberIds &&
          request.resource.data.fromUid != request.resource.data.toUid;
        allow update, delete: if false;
      }

      // Activity Subcollection (Append-only activity log)
      match /activity/{activityId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
