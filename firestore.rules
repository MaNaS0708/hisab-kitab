rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isExistingMember(groupId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isMemberAfterBatch(groupId) {
      return isAuthenticated() &&
        existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupMember(groupId) {
      return isExistingMember(groupId) || isMemberAfterBatch(groupId);
    }

    // Users Collection: User may read and write only their own profile
    match /users/{uid} {
      allow read, write: if isUser(uid);
    }

    // Usernames Collection: For unique username lookup, immutable after creation
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid;
      allow update, delete: false;
    }

    // Groups Collection
    match /groups/{groupId} {
      // Group creation: authenticated creator, createdBy is auth user, creator in memberIds
      allow create: if isAuthenticated() &&
                    request.resource.data.createdBy == request.auth.uid &&
                    request.auth.uid in request.resource.data.memberIds;

      // Group read: group members only
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;

      // Existing group root: deny arbitrary updates; only allow safe updatedAt touch by members
      allow update: if isAuthenticated() &&
                    request.auth.uid in resource.data.memberIds &&
                    request.resource.data.createdBy == resource.data.createdBy &&
                    request.resource.data.memberIds == resource.data.memberIds &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);

      allow delete: false;

      // Members Subcollection: created during group creation batch
      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId);
        allow update, delete: false;
      }

      // Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isExistingMember(groupId);
        allow create: if isExistingMember(groupId) &&
                      request.resource.data.createdByUid == request.auth.uid &&
                      request.resource.data.amountPaise is int &&
                      request.resource.data.amountPaise > 0 &&
                      request.resource.data.paidByUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds &&
                      get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAll(request.resource.data.participantIds) &&
                      request.resource.data.splitType in ['equal', 'custom'];
        allow update, delete: false;
      }

      // Settlements Subcollection
      match /settlements/{settlementId} {
        allow read: if isExistingMember(groupId);
        allow create: if isExistingMember(groupId) &&
                      request.resource.data.createdByUid == request.auth.uid &&
                      request.resource.data.amountPaise is int &&
                      request.resource.data.amountPaise > 0 &&
                      request.resource.data.fromUid != request.resource.data.toUid &&
                      request.resource.data.fromUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds &&
                      request.resource.data.toUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: false;
      }

      // Activity Subcollection
      match /activity/{activityId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
                      request.resource.data.actorUid == request.auth.uid;
        allow update, delete: false;
      }
    }
  }
}

