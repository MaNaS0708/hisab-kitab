<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.HisabKitab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="materialButtonStyle">@style/Widget.HisabKitab.Button</item>
        <item name="textInputStyle">@style/Widget.HisabKitab.TextInputLayout</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.HisabKitab.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.HisabKitab.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.HisabKitab.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.HisabKitab.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.HisabKitab.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.HisabKitab.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.HisabKitab.LabelLarge</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.HisabKitab" parent="Base.Theme.HisabKitab" />

    <style name="Theme.HisabKitab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.HisabKitab</item>
    </style>

    <style name="Widget.HisabKitab.OtpDigit" parent="@android:style/Widget.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/otp_box_size</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">@dimen/otp_digit_gap</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">6</item>
        <item name="android:maxLines">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Widget.HisabKitab.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_card_background</item>
        <item name="strokeColor">@color/color_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="TextAppearance.HisabKitab.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HisabKitab.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HisabKitab.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HisabKitab.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HisabKitab.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.HisabKitab.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>

    <style name="TextAppearance.HisabKitab.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.HisabKitab.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.HisabKitab.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/control_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="strokeColor">@color/color_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="Widget.HisabKitab.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/control_corner_radius</item>
    </style>
</resources>
