<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.HisabKitab" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.HisabKitab" parent="Base.Theme.HisabKitab" />
    <style name="Theme.HisabKitab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.HisabKitab</item>
    </style>
    <style name="Widget.HisabKitab.OtpDigit" parent="@android:style/Widget.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/otp_box_size</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">@dimen/otp_digit_gap</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">6</item>
        <item name="android:maxLines">1</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">20sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>