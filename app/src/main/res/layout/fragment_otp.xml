<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/otp_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phone_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />

            <!-- OTP Card Container -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.HisabKitab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:id="@+id/otp_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/digit_1"
                            style="@style/Widget.HisabKitab.OtpDigit"
                            android:contentDescription="@string/otp_digit_1_description"
                            android:imeOptions="actionNext" />

                        <EditText
                            android:id="@+id/digit_2"
                            style="@style/Widget.HisabKitab.OtpDigit"
                            android:contentDescription="@string/otp_digit_2_description"
                            android:imeOptions="actionNext" />

                        <EditText
                            android:id="@+id/digit_3"
                            style="@style/Widget.HisabKitab.OtpDigit"
                            android:contentDescription="@string/otp_digit_3_description"
                            android:imeOptions="actionNext" />

                        <EditText
                            android:id="@+id/digit_4"
                            style="@style/Widget.HisabKitab.OtpDigit"
                            android:contentDescription="@string/otp_digit_4_description"
                            android:imeOptions="actionNext" />

                        <EditText
                            android:id="@+id/digit_5"
                            style="@style/Widget.HisabKitab.OtpDigit"
                            android:contentDescription="@string/otp_digit_5_description"
                            android:imeOptions="actionNext" />

                        <EditText
                            android:id="@+id/digit_6"
                            style="@style/Widget.HisabKitab.OtpDigit"
                            android:contentDescription="@string/otp_digit_6_description"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:textColor="@color/color_error"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retry_button"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/retry"
                        android:visibility="gone" />

                    <!-- Verify Button Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/verify_otp_button"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:text="@string/verify_otp"
                            app:cornerRadius="@dimen/control_corner_radius" />

                        <ProgressBar
                            android:id="@+id/loading_indicator"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:indeterminateTint="@color/color_primary"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Resend Button Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/resend_otp_button"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:text="@string/resend_otp"
                            app:cornerRadius="@dimen/control_corner_radius" />

                        <ProgressBar
                            android:id="@+id/resend_otp_loading_indicator"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="@dimen/space_md"
                            android:indeterminateTint="@color/color_primary"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
